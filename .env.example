# Copy this file to .env and fill in a strong password.
# SQL Server SA password: must be 8+ chars and include upper, lower, digit, and symbol.
MSSQL_SA_PASSWORD=ChangeMe!123456

# Password for the read-only "haul_api" login (see db/readonly-login.sql). Same
# complexity rule as above.
HAUL_API_PASSWORD=ChangeMe!ReadOnly123

# Connection string the API reads at startup (HAUL_API_DB_CONN). Uses the read-only
# haul_api login, never sa. Keep the password in sync with HAUL_API_PASSWORD above.
HAUL_API_DB_CONN=Server=localhost,1433;Database=HaulCycleInsights;User Id=haul_api;Password=ChangeMe!ReadOnly123;TrustServerCertificate=True
