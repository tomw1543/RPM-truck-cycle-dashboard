# Base URL of the HaulCycle Insights API.
#
# Leave empty in development - the Vite dev server proxies /api and /health to
# http://localhost:5281 (see vite.config.ts), so relative paths just work.
#
# Set to the deployed API's origin (no trailing slash) for a production build,
# e.g. https://haulcycle-api.azurewebsites.net
VITE_API_BASE_URL=

# Set to exactly "true" to hide the live-data toggle in the header (e.g. on a public
# deployment where streaming a live data-generator run isn't available). Leave unset to
# show it - this is the default, and dev behavior is unchanged.
VITE_HIDE_LIVE_TOGGLE=
